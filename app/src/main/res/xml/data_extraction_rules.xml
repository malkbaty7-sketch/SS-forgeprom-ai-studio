<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+: نستبعد من النسخ السحابي والانتقال بين الأجهزة:
  قاعدة المشاريع، والمفاتيح المشفرة، والمسودات غير المحفوظة.
  النسخ الاحتياطي الصريح من داخل التطبيق (JSON) يبقى متاحاً بيد المستخدم.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="forgeprom.db" />
        <exclude domain="database" path="forgeprom.db-wal" />
        <exclude domain="database" path="forgeprom.db-shm" />
        <exclude domain="sharedpref" path="forgeprom_secure_keys.xml" />
        <exclude domain="sharedpref" path="forgeprom_editor_drafts.xml" />
        <exclude domain="sharedpref" path="forgeprom_local_account.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="forgeprom_secure_keys.xml" />
        <exclude domain="sharedpref" path="forgeprom_local_account.xml" />
    </device-transfer>
</data-extraction-rules>
