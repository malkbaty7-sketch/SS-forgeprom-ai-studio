# انسخ هذا الملف إلى .env ولا تضعه في git. هذه قيم توضيحية فقط.

# مزود التوليد (إلزامي)
OPENAI_API_KEY=replace-with-server-side-key
OPENAI_MODEL=gpt-4o-mini

# حسابات فردية: مصفوفة JSON بمعرّف وتجزئة SHA-256 للرمز وخطة.
# GATEWAY_ACCOUNTS=[{"id":"alice","hash":"<sha256-hex>","plan":"free"}]
GATEWAY_ACCOUNTS=

# رمز مشرف اختياري (32 بايت على الأقل) — لا تستخدمه في تطبيق موزّع.
GATEWAY_TOKEN=

# قاعدة PostgreSQL اختيارية للحصص المشتركة والمهام والاستهلاك.
DATABASE_URL=
ENABLE_JOBS=0
ENABLE_USAGE=0
ENABLE_STORY_INDEX=0
ENABLE_BILLING=0
STRIPE_SECRET_KEY=
STRIPE_CUSTOMERS=
ENABLE_WEB_SEARCH=0
BRAVE_SEARCH_API_KEY=

# الشبكة
PORT=8080
HOST=0.0.0.0
